# ============================================================
#  morgemitenand.ch — Apache config for Infomaniak shared hosting
#  Upload the contents of dist/ to the site's web root.
# ============================================================

# ---- Force HTTPS and strip www --------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # Serve /de from de.html, with no redirect and no trailing slash
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.+?)/?$ /$1.html [L]
</IfModule>

# ---- Security headers ------------------------------------------------------
<IfModule mod_headers.c>
  # The site loads nothing from any third-party origin, so everything
  # off-origin is simply denied. Inline scripts/styles are Astro's own,
  # emitted at build time — see docs/DEPLOY.md for the CSP-hash upgrade path.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests"

  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"

  Header unset X-Powered-By
  Header unset Server
</IfModule>

# ---- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/plain text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# ---- Caching ---------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  # Fingerprinted build assets are immutable.
  <FilesMatch "\.(css|js|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(svg|png|jpg|jpeg|webp|avif|ico)$">
    ExpiresDefault "access plus 30 days"
  </FilesMatch>
  # HTML must revalidate so a deploy is visible immediately.
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ---- Hardening -------------------------------------------------------------
Options -Indexes -MultiViews
ServerSignature Off

<FilesMatch "^\.|(\.(jsonl|log|env|md|lock|json)|~)$">
  Require all denied
</FilesMatch>
# join.php needs to stay reachable; nothing else in /api does.
<Files "join.php">
  Require all granted
</Files>

ErrorDocument 404 /404.html
